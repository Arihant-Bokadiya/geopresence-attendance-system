# ==============================================================================
# GeoPresence Attendance System — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in production / local environments:
#    cp .env.example .env
# 2. Provide cryptographically strong secrets for all secret keys.
# 3. Never commit '.env' containing real secrets to version control.
# ==============================================================================

# Server Environment Mode
# Options: development | test | production
NODE_ENV=development

# Server Port
PORT=4050

# Client Web Application URL (for CORS and WebAuthn origin validation)
CORS_ORIGIN=http://localhost:5180

# Primary Application Database Connection URL
# For SQLite (local development): file:./dev.db
# For PostgreSQL (production deployment): postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=file:./dev.db

# Test Database Connection URL (Isolated from production business data)
TEST_DATABASE_URL=file:./test.db

# Authentication Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_at_least_32_chars
SESSION_SECRET=replace_with_a_secure_random_session_secret_key

# WebAuthn / Passkeys Configuration
# WEBAUTHN_RP_ID: Effective domain where passkeys are registered (e.g., college.edu or localhost)
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN: Comma-separated list of allowed client origins for WebAuthn ceremony
WEBAUTHN_ORIGIN=http://localhost:5180,http://127.0.0.1:5180

# Campus Network Security (Optional CIDR ranges for campus Wi-Fi network validation)
CAMPUS_WIFI_CIDR=192.168.0.0/16,10.0.0.0/8

# Classroom Hardware / ESP32 Device Configuration
# CLASSROOM_PRESENCE_PROVIDER: Options: ESP32_BLE | DEVELOPMENT_SIMULATION
CLASSROOM_PRESENCE_PROVIDER=DEVELOPMENT_SIMULATION
ESP32_SECRET_HMAC_KEY=replace_with_esp32_device_hmac_secret_key
