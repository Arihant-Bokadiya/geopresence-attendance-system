# ==============================================================================
# GeoPresence Attendance System — Backend Environment Configuration Template
# ==============================================================================
NODE_ENV=development
PORT=4050
CORS_ORIGIN=http://localhost:5180
DATABASE_URL=file:./dev.db
TEST_DATABASE_URL=file:./test.db
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_at_least_32_chars
SESSION_SECRET=replace_with_a_secure_random_session_secret_key
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5180,http://127.0.0.1:5180
CAMPUS_WIFI_CIDR=192.168.0.0/16,10.0.0.0/8
CLASSROOM_PRESENCE_PROVIDER=DEVELOPMENT_SIMULATION
ESP32_SECRET_HMAC_KEY=replace_with_esp32_device_hmac_secret_key
