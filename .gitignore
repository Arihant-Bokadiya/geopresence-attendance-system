# ==============================================================================
# GeoPresence Attendance System — Root Git Ignore Rules
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Python Virtual Environments & Bytecode (if used by tooling/scripts)
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT REAL CREDENTIALS)
.env
.env.*
*.env
!.env.example
!*.env.example

# Local Database Files (CRITICAL: NEVER COMMIT LOCAL/PRODUCTION DATABASES)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
server/prisma/*.db
server/prisma/*.db-journal
server/prisma/*.db-wal
server/prisma/*.db-shm

# Build Artifacts & Compiled Bundles
dist/
dist-ssr/
build/
client/dist/
server/dist/
*.tsbuildinfo

# Test Coverage & Benchmarks
coverage/
*.lcov
.nyc_output/

# Logs & Debugging Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Temporary Directories
.cache/
.temp/
.tmp/
*.tmp
*.temp
client/node_modules/.vite/
client/node_modules/.vite-temp/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
