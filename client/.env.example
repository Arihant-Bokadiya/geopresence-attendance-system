# ==============================================================================
# GeoPresence Attendance System — Client Environment Configuration Template
# ==============================================================================
# Instructions:
# In development:
# - Leave VITE_API_URL empty/unset to automatically use relative '/api/v1',
#   which proxies through Vite dev server to backend on port 4050.
#   This allows any LAN device (phone, laptop) to connect seamlessly to port 5180.
# - If connecting directly to an external backend URL, specify it here:
#   VITE_API_URL=http://localhost:4050/api/v1
# ==============================================================================

VITE_API_URL=
